MAKEFILE_DIR := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))

# Variables
# TOP tracks whichever slot_<N> was last generated by top-schem/top-layout (see .top_cell below).
# Falls back to the submission cell name if no slot has been generated yet.
TOP_CELL_FILE := .top_cell
TOP := $(shell cat $(TOP_CELL_FILE) 2>/dev/null || echo gf180mcu_chipalooza_analog_project)

.DEFAULT_GOAL := help

# Cell name for verification targets (default: top-level cell)
# Override with: make <target> CELL=<cellname>
CELL ?= $(TOP)

# PEX mode (1 = C-decoupled, 2 = C-coupled, 3 = full-RC)
# Override with: make <target> EXT_MODE=<1|2|3>
EXT_MODE ?= 3

# full-RC extresist threshold in mOhm (sak-pex.sh -t, only used in EXT_MODE=3; default: 10000 = 10 Ohm)
# Override with: make <target> THRESHOLD=<mOhm>
THRESHOLD ?= 10000

# full-RC extresist minres in mOhm (sak-pex.sh -r, only used in EXT_MODE=3; default: 1000 = 1 Ohm)
# Override with: make <target> MINRES=<mOhm>
MINRES ?= 1000

# full-RC extresist mindelay in ps (sak-pex.sh -y, only used in EXT_MODE=3; default: 1; 0 = gate by resistance)
# Override with: make <target> MINDELAY=<ps>
MINDELAY ?= 1

# KLayout DRC level: precheck, macro, or regular (sak-drc.sh -l, only used by klayout-drc; default: macro)
# Override with: make <target> DRC_LEVEL=<precheck|macro|regular>
DRC_LEVEL ?= macro

# Skip klayout-lvs inside klayout-verify/klayout-verify-all/all (default: 0, i.e. it runs).
# gf180mcuD's KLayout LVS runset doesn't combine parallel multi-finger devices by default, so
# it reports a device-count mismatch against an nf>1 schematic that Magic+Netgen (magic-lvs)
# correctly merges and passes. Set to 1 to rely on magic-lvs alone until that's addressed.
# Override with: make <target> SKIP_KLAYOUT_LVS=<0|1>
SKIP_KLAYOUT_LVS ?= 0

# Use magic-lvs-mixed instead of plain magic-lvs inside magic-verify/magic-verify-all/all
# (default: 0, i.e. plain magic-lvs runs). Plain magic-lvs/sak-lvs.sh always flattens the whole
# layout before extraction, which destroys a hardened digital macro's cell boundary and makes
# LVS fail once one is placed in CELL. Set to 1 for a design containing one (e.g. with
# SKIP_KLAYOUT_LVS=1, since KLayout LVS has no equivalent mixed-signal path yet).
# Override with: make <target> MIXED_LVS=<0|1>
MIXED_LVS ?= 0

# Floating-point precision (significant digits) for Xschem's ev function
# Override with: make <target> EV_PRECISION=<digits>
EV_PRECISION ?= 5

# Preferred GDS extension: use .gds when available for the CELL, otherwise .klay.gds
# Resolved per CELL (CELL defaults to TOP), so cells can mix .gds and .klay.gds within one macro.
# All DRC, LVS and PEX targets (KLayout and Magic) work with either .gds or .klay.gds.
_GDS_EXT = $(if $(wildcard $(LAY_DIR)/$(CELL).gds),gds,klay.gds)

# Extra options for the sak-open.py file browser (e.g. --all to include build outputs)
# Override with: make open OPEN_ARGS=<options>
OPEN_ARGS ?=

# Folder structure
MACROS_DIR      := macros
FLOORPLAN_DIR   := floorplan
XSCHEM_SCH_DIR  := schematic/xschem
XSCHEM_TB_DIR   := testbenches/xschem
LAY_DIR         := layout
SCRIPTS_DIR     := scripts
SIM_PLOT_DIR    := testbenches/xschem/plot_simulations
GDS_DIR         := final/gds
LEF_DIR         := final/lef
LIB_DIR         := final/lib
VH_DIR          := final/vh
RENDER_IMG_DIR  := render/img
NET_SCH_DIR     := netlist/schematic
NET_LAY_DIR     := netlist/layout
NET_PEX_DIR     := netlist/pex
LVS_RPT_DIR     := verification/lvs
DRC_RPT_DIR     := verification/drc


# Help Target
help: ## Show this help message
	@echo 'Usage: make <target> [CELL=<cellname>] [EXT_MODE=<1|2|3>] [THRESHOLD=<mOhm>] [MINRES=<mOhm>] [MINDELAY=<ps>] [DRC_LEVEL=<precheck|macro|regular>] [SKIP_KLAYOUT_LVS=<0|1>] [MIXED_LVS=<0|1>] [EV_PRECISION=<digits>] [TB=<testbenchname>] [SCRIPT=<scriptname>] [OPEN_ARGS=<options>] [SLOT=<1-18>]'
	@echo ''
	@echo 'Available targets:'
	@grep -E '^[a-zA-Z0-9_.-]+:.*## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*## "}; {printf "  %-20s %s\n", $$1, $$2}'
	@echo ''
	@echo 'CELL defaults to $(TOP). Override to verify subcells.'
	@echo 'EXT_MODE defaults to 3 (full-RC). 1=C-decoupled, 2=C-coupled.'
	@echo 'THRESHOLD/MINRES/MINDELAY are full-RC (EXT_MODE=3) extresist settings for magic-pex (defaults 10000 mOhm / 1000 mOhm / 1 ps).'
	@echo 'DRC_LEVEL defaults to macro. Sets the KLayout DRC level for klayout-drc (precheck|macro|regular).'
	@echo 'SKIP_KLAYOUT_LVS defaults to 0. Set to 1 to skip klayout-lvs inside klayout-verify/klayout-verify-all/all (magic-lvs still runs).'
	@echo 'MIXED_LVS defaults to 0. Set to 1 to run magic-lvs-mixed instead of magic-lvs inside magic-verify/magic-verify-all/all (needed once a hardened digital macro is placed in CELL).'
	@echo 'EV_PRECISION defaults to 5 significant digits for xschem ev function.'
	@echo 'TB selects the Xschem testbench for sim-xschem (default: <CELL>_tb_tran).'
	@echo 'SCRIPT selects the plotting script for sim-view-xschem (default: plot_<CELL>).'
	@echo 'OPEN_ARGS passes extra options to sak-open.py for the open target (e.g. --all).'
	@echo 'SLOT selects the floorplan slot number for top-schem/top-layout (no default, required).'
.PHONY: help
# ================================================================================================


# Open Target
open: ## Open the design files of this folder in the sak-open.py file browser (needs the VNC/X11 desktop)
	sak-open.py $(OPEN_ARGS) .
.PHONY: open
# ================================================================================================


# Pull Wrappers Target
WRAPPER_REPO := https://github.com/RTimothyEdwards/gf180mcu_ocd_chipalooza.git
WRAPPER_SLOTS := $(shell seq 1 18)

pull-wrappers: ## Pull the latest slot1-18 floorplan wrapper GDS files from the gf180mcu_ocd_chipalooza harness repo
	rm -rf $(FLOORPLAN_DIR)/.wrapper_pull
	git clone --depth 1 --filter=blob:none --sparse $(WRAPPER_REPO) $(FLOORPLAN_DIR)/.wrapper_pull
	cd $(FLOORPLAN_DIR)/.wrapper_pull && git sparse-checkout init --no-cone && git sparse-checkout set "gds/slot*_wrapper.gds"
	mkdir -p $(FLOORPLAN_DIR)
	for n in $(WRAPPER_SLOTS); do cp $(FLOORPLAN_DIR)/.wrapper_pull/gds/slot$$n\_wrapper.gds $(FLOORPLAN_DIR)/; done
	rm -rf $(FLOORPLAN_DIR)/.wrapper_pull
	@echo "Pulled slot1_wrapper.gds .. slot18_wrapper.gds into $(FLOORPLAN_DIR)/ from $(WRAPPER_REPO)"
.PHONY: pull-wrappers

# SLOT to target for top-schem (no default: must be given explicitly)
# Override with: make top-schem SLOT=<1-18>
SLOT ?=

top-schem: ## Sync the top slot_<N> schematic to a floorplan slot's wrapper pins and regenerate its sym/pex-sym (usage: make top-schem SLOT=<1-18>)
	@if [ -z "$(SLOT)" ]; then \
		echo "ERROR: SLOT is required. Usage: make top-schem SLOT=<1-18>"; \
		exit 1; \
	fi
	python3 $(SCRIPTS_DIR)/sync_wrapper_pins.py $(SLOT) --floorplan-dir $(FLOORPLAN_DIR) --schem-dir $(XSCHEM_SCH_DIR)
	$(MAKE) symbol-pex CELL=slot_$(SLOT)
	echo slot_$(SLOT) > $(TOP_CELL_FILE)
.PHONY: top-schem

top-layout: ## Copy a floorplan slot wrapper into layout/ as slot_<N>.gds, renaming its top cell to slot_<N> (usage: make top-layout SLOT=<1-18>)
	@if [ -z "$(SLOT)" ]; then \
		echo "ERROR: SLOT is required. Usage: make top-layout SLOT=<1-18>"; \
		exit 1; \
	fi
	mkdir -p $(LAY_DIR)
	python3 $(SCRIPTS_DIR)/rename_gds_cell.py $(FLOORPLAN_DIR)/slot$(SLOT)_wrapper.gds $(LAY_DIR)/slot_$(SLOT).gds slot$(SLOT)_wrapper slot_$(SLOT)
.PHONY: top-layout
# ================================================================================================


# Simulation Targets
# Testbench for the Xschem simulation targets (default: <CELL>_tb_tran)
# Override with: make <target> TB=<testbenchname>
TB ?= $(CELL)_tb_tran
# Plotting script for sim-view-xschem (default: plot_<CELL>)
# Override with: make <target> SCRIPT=<scriptname>
SCRIPT ?= plot_$(CELL)

sim-xschem: ## Run TB simulation with Xschem in batch mode (usage: make sim-xschem [TB=<testbenchname>])
	mkdir -p $(XSCHEM_TB_DIR)/simulations
	mkdir -p $(SIM_PLOT_DIR)/data
	cd $(XSCHEM_TB_DIR) && xschem -r -x -q --rcfile xschemrc --command ' \
		xschem set netlist_type spice; \
		set netlist_dir $(abspath $(XSCHEM_TB_DIR)/simulations); \
		xschem save; \
		write_data [save_params] $(abspath $(XSCHEM_TB_DIR)/simulations)/$(TB).save; \
		xschem netlist \
	' $(TB).sch
	cd $(XSCHEM_TB_DIR)/simulations && ngspice -b $(TB).spice
.PHONY: sim-xschem

sim-view-xschem: ## Plot Xschem simulation results (usage: make sim-view-xschem [SCRIPT=<scriptname>])
	SHOW_PLOTS=1 python3 $(SIM_PLOT_DIR)/$(SCRIPT).py
.PHONY: sim-view-xschem


sim-all: ## Simulate the macro
	$(MAKE) sim-xschem TB=$(TOP)_tb_tran
.PHONY: sim-all
# ================================================================================================


# Build Targets
build-counter: ## Lint, build, verify and simulate the counter macro
	@$(MAKE) -C $(MACROS_DIR)/counter all
.PHONY: build-counter

build-inverter: ## Verify, build and simulate the inverter macro
	@$(MAKE) -C $(MACROS_DIR)/inverter all
.PHONY: build-inverter

build-macros: ## Verify, build and simulate all macros (counter and inverter)
	$(MAKE) build-counter
	$(MAKE) build-inverter
#	ToDo: further macros
.PHONY: build-macros

build-top: ## Build TOP cell (check PR boundary, Verilog, LEF, LIB, copy GDS, and render images)
	$(MAKE) check-boundary
	$(MAKE) lef
	$(MAKE) lib
	$(MAKE) verilog
	$(MAKE) copy-gds
	$(MAKE) render-gds
.PHONY: build-top
# ================================================================================================


# PR Boundary Check Target
check-boundary: ## Check that the TOP cell layout carries the PR boundary box on layer 0 that the chip flow needs
	python3 $(SCRIPTS_DIR)/check_boundary.py $(LAY_DIR)/$(TOP).gds $(TOP)
.PHONY: check-boundary
# ================================================================================================


# LEF Target
lef: ## Export LEF from the TOP cell layout using Magic
	rm -rf $(LEF_DIR)
	mkdir -p $(LEF_DIR)
	printf '%s\n' \
		'gds read $(LAY_DIR)/$(TOP).gds' \
		'load $(TOP)' \
		'lef write $(LEF_DIR)/$(TOP).lef -hide -pinonly 2um' | \
		magic -dnull -noconsole \
		-rcfile $(PDK_ROOT)/$(PDK)/libs.tech/magic/$(PDK).magicrc
.PHONY: lef
# ================================================================================================


# LIB Target
lib: ## Generate a Liberty timing library for the TOP cell
	rm -rf $(LIB_DIR)
	mkdir -p $(LIB_DIR)
	@printf 'library ($(TOP)) {\n  input_threshold_pct_fall: 50.0;\n  input_threshold_pct_rise: 50.0;\n  output_threshold_pct_fall: 50.0;\n  output_threshold_pct_rise: 50.0;\n  slew_lower_threshold_pct_fall: 20.0;\n  slew_lower_threshold_pct_rise: 20.0;\n  slew_upper_threshold_pct_fall: 80.0;\n  slew_upper_threshold_pct_rise: 80.0;\n  \n  cell ($(TOP)) {\n  }\n}\n' > $(LIB_DIR)/$(TOP).lib
.PHONY: lib
# ================================================================================================


# Verilog Target
verilog: ## Generate a Verilog stub of the TOP cell from Magic or KLayout PEX netlist pins
	rm -rf $(VH_DIR)
	mkdir -p $(VH_DIR)
	@pex_netlist=""; \
	for f in \
		$(NET_PEX_DIR)/$(TOP)_magic_pex_1.spice \
		$(NET_PEX_DIR)/$(TOP)_magic_pex_2.spice \
		$(NET_PEX_DIR)/$(TOP)_magic_pex_3.spice \
		$(NET_PEX_DIR)/$(TOP)_klayout_pex_1.spice \
		$(NET_PEX_DIR)/$(TOP)_klayout_pex_2.spice \
		$(NET_PEX_DIR)/$(TOP)_klayout_pex_3.spice; do \
		if [ -f "$$f" ]; then \
			pex_netlist="$$f"; \
			break; \
		fi; \
	done; \
	if [ -z "$$pex_netlist" ]; then \
		echo "ERROR: No PEX netlist found for $(TOP). Expected one of:"; \
		echo "  $(NET_PEX_DIR)/$(TOP)_magic_pex_{1,2,3}.spice"; \
		echo "  $(NET_PEX_DIR)/$(TOP)_klayout_pex_{1,2,3}.spice"; \
		echo "Run 'make magic-pex' or 'make klayout-pex' first."; \
		exit 1; \
	fi; \
	echo "Reading pins from $$pex_netlist..."; \
	pex_pins=$$(awk '/^\.subckt $(TOP)_pex/{sub(/^\.subckt [^ ]+ /,"");p=$$0;next} p&&/^[+]/{sub(/^[+] */,"");p=p" "$$0;next} p{exit} END{print p}' "$$pex_netlist"); \
	power_pins=$$(echo "$$pex_pins" | tr ' ' '\n' | grep -E '^(VDD|VSS|VPWR|VDPWR|VAPWR|VGND|VNB|VPB)$$' | sort -u | tr '\n' ' '); \
	signal_pins=$$(echo "$$pex_pins" | tr ' ' '\n' | grep -vE '^(VDD|VSS|VPWR|VDPWR|VAPWR|VGND|VNB|VPB)$$' | grep -v '^$$' | sort | tr '\n' ' '); \
	{ \
		echo 'module $(TOP) ('; \
		if [ -n "$$(echo $$power_pins | xargs)" ]; then \
			echo '`ifdef USE_POWER_PINS'; \
			for p in $$power_pins; do echo "    inout $$p,"; done; \
			echo '`endif'; \
		fi; \
		echo "$$signal_pins" | tr ' ' '\n' | grep -v '^$$' | awk ' \
			{ name=$$0; idx=-1; base=name; \
			  if (name ~ /\[[0-9]+\]$$/) { p=index(name,"["); base=substr(name,1,p-1); idx=substr(name,p+1,length(name)-p-1)+0; } \
			  if (!(base in lo)) { order[++n]=base; lo[base]=idx; hi[base]=idx; } \
			  if (idx>=0) { if (lo[base]<0 || idx<lo[base]) lo[base]=idx; if (idx>hi[base]) hi[base]=idx; } } \
			END { for (i=1;i<=n;i++) { b=order[i]; \
			  t="inout"; if (b ~ /^di_/) t="input"; else if (b ~ /^do_/) t="output"; \
			  if (lo[b]<0) line="    " t " " b; else line="    " t " [" hi[b] ":" lo[b] "] " b; \
			  printf "%s%s\n", line, (i<n ? "," : ""); } } \
		'; \
		echo ');'; \
		echo 'endmodule'; \
	} > $(VH_DIR)/$(TOP).vh
.PHONY: verilog
# ================================================================================================


# Copy Target
copy-gds: ## Copy the TOP cell GDS from layout/ to final/gds/
	rm -rf $(GDS_DIR)
	mkdir -p $(GDS_DIR)
	cp $(LAY_DIR)/$(TOP).gds $(GDS_DIR)/$(TOP).gds
.PHONY: copy-gds
# ================================================================================================


# Render Target
render-gds: ## Render images from the final GDS using sak-render.py
	rm -rf $(RENDER_IMG_DIR)/
	mkdir -p $(RENDER_IMG_DIR)/
	sak-render.py -t $(PDK) -w 2048 -s 4 -o $(RENDER_IMG_DIR)/$(TOP) $(LAY_DIR)/$(TOP).gds
.PHONY: render-gds
# ================================================================================================


# Fill Target
# MetalTop has no native gdsfill support on gf180mcuD, so it's filled via a relabeled-as-Metal5
# scratch copy; both passes then re-tile at gf180mcu's real 0.98um min spacing (gdsfill's own
# Metal5/MetalTop density can't otherwise clear the 30% DRC floor) before transplanting the
# resulting fill layers back into the real CELL.
gds-fill: ## Insert PDK-compliant dummy fill into CELL's layout via gdsfill (backs up first; usage: make gds-fill [CELL=<cellname>])
	mkdir -p $(LAY_DIR)/backups
	@TS=$$(date +%Y-%m-%d_%Hh%Mm%S); RAND=$$((RANDOM % 1000)); \
	BACKUP=$(LAY_DIR)/backups/$(CELL)_backup_$${TS}_$$(printf '%03d' $$RAND).gds; \
	cp -v $(LAY_DIR)/$(CELL).$(_GDS_EXT) "$$BACKUP"; \
	python3 $(SCRIPTS_DIR)/make_mt_as_m5_scratch.py $(LAY_DIR)/$(CELL).$(_GDS_EXT) /tmp/$(CELL)_mt_scratch.gds && \
	python3 $(SCRIPTS_DIR)/rescale_dbu.py /tmp/$(CELL)_mt_scratch.gds /tmp/$(CELL)_mt_scratch.gds 0.005 && \
	python3 $(SCRIPTS_DIR)/resize_prbndry.py /tmp/$(CELL)_mt_scratch.gds 26 && \
	python3 $(SCRIPTS_DIR)/apply_blk_workaround.py /tmp/$(CELL)_mt_scratch.gds && \
	gdsfill fill --process $(PDK) --config-file gdsfill.yaml /tmp/$(CELL)_mt_scratch.gds && \
	python3 $(SCRIPTS_DIR)/fill_dense_metal.py /tmp/$(CELL)_mt_scratch.gds 81 && \
	python3 $(SCRIPTS_DIR)/rescale_dbu.py /tmp/$(CELL)_mt_scratch.gds /tmp/$(CELL)_mt_scratch.gds 0.001 && \
	python3 $(SCRIPTS_DIR)/extract_mt_from_m5.py /tmp/$(CELL)_mt_scratch.gds $(LAY_DIR)/$(CELL).$(_GDS_EXT) && \
	rm -f /tmp/$(CELL)_mt_scratch.gds; \
	python3 $(SCRIPTS_DIR)/flatten_gds.py $(LAY_DIR)/$(CELL).$(_GDS_EXT) /tmp/$(CELL)_fill_scratch.gds && \
	python3 $(SCRIPTS_DIR)/rescale_dbu.py /tmp/$(CELL)_fill_scratch.gds /tmp/$(CELL)_fill_scratch.gds 0.005 && \
	python3 $(SCRIPTS_DIR)/resize_prbndry.py /tmp/$(CELL)_fill_scratch.gds 26 && \
	python3 $(SCRIPTS_DIR)/apply_blk_workaround.py /tmp/$(CELL)_fill_scratch.gds && \
	gdsfill fill --process $(PDK) --config-file gdsfill.yaml /tmp/$(CELL)_fill_scratch.gds && \
	python3 $(SCRIPTS_DIR)/fill_dense_metal.py /tmp/$(CELL)_fill_scratch.gds 81 && \
	python3 $(SCRIPTS_DIR)/rescale_dbu.py /tmp/$(CELL)_fill_scratch.gds /tmp/$(CELL)_fill_scratch.gds 0.001 && \
	python3 $(SCRIPTS_DIR)/extract_fill_layers.py /tmp/$(CELL)_fill_scratch.gds $(LAY_DIR)/$(CELL).$(_GDS_EXT); \
	rm -f /tmp/$(CELL)_fill_scratch.gds
.PHONY: gds-fill

gds-fill-comp: ## Re-run gdsfill and copy back ONLY the comp_dummy (22/4) layer, leaving every other layer's existing fill untouched (backs up first; usage: make gds-fill-comp [CELL=<cellname>])
	mkdir -p $(LAY_DIR)/backups
	@TS=$$(date +%Y-%m-%d_%Hh%Mm%S); RAND=$$((RANDOM % 1000)); \
	BACKUP=$(LAY_DIR)/backups/$(CELL)_backup_$${TS}_$$(printf '%03d' $$RAND).gds; \
	cp -v $(LAY_DIR)/$(CELL).$(_GDS_EXT) "$$BACKUP"; \
	python3 $(SCRIPTS_DIR)/flatten_gds.py $(LAY_DIR)/$(CELL).$(_GDS_EXT) /tmp/$(CELL)_comp_scratch.gds && \
	python3 $(SCRIPTS_DIR)/rescale_dbu.py /tmp/$(CELL)_comp_scratch.gds /tmp/$(CELL)_comp_scratch.gds 0.005 && \
	python3 $(SCRIPTS_DIR)/resize_prbndry.py /tmp/$(CELL)_comp_scratch.gds 26 && \
	python3 $(SCRIPTS_DIR)/apply_blk_workaround.py /tmp/$(CELL)_comp_scratch.gds && \
	gdsfill fill --process $(PDK) --config-file gdsfill.yaml /tmp/$(CELL)_comp_scratch.gds && \
	python3 $(SCRIPTS_DIR)/rescale_dbu.py /tmp/$(CELL)_comp_scratch.gds /tmp/$(CELL)_comp_scratch.gds 0.001 && \
	python3 $(SCRIPTS_DIR)/extract_fill_layers.py /tmp/$(CELL)_comp_scratch.gds $(LAY_DIR)/$(CELL).$(_GDS_EXT) 22:4; \
	rm -f /tmp/$(CELL)_comp_scratch.gds
.PHONY: gds-fill-comp

gds-fill-undo: ## Restore CELL's layout from its most recent backup in layout/backups/ (usage: make gds-fill-undo [CELL=<cellname>])
	@LATEST=$$(ls -t $(LAY_DIR)/backups/$(CELL)_backup_*.gds 2>/dev/null | head -1); \
	if [ -z "$$LATEST" ]; then \
		echo "[ERROR] No backups found matching $(LAY_DIR)/backups/$(CELL)_backup_*.gds"; \
		exit 1; \
	fi; \
	echo "[INFO] Restoring $$LATEST -> $(LAY_DIR)/$(CELL).$(_GDS_EXT)"; \
	cp -v "$$LATEST" $(LAY_DIR)/$(CELL).$(_GDS_EXT)
.PHONY: gds-fill-undo
# ================================================================================================


# DRC Targets
klayout-drc: ## Run KLayout DRC of the CELL cell (usage: make klayout-drc [CELL=<cellname>] [DRC_LEVEL=<precheck|macro|regular>])
	mkdir -p $(DRC_RPT_DIR)
	sak-drc.sh -d -k -l $(DRC_LEVEL) -w $(DRC_RPT_DIR) $(LAY_DIR)/$(CELL).$(_GDS_EXT)
.PHONY: klayout-drc

magic-drc: ## Run Magic DRC of the CELL cell (usage: make magic-drc [CELL=<cellname>])
	mkdir -p $(DRC_RPT_DIR)
	sak-drc.sh -d -m -f "*" -w $(DRC_RPT_DIR) $(LAY_DIR)/$(CELL).$(_GDS_EXT)
.PHONY: magic-drc

load-drc-klayout: ## Open the KLayout GUI with CELL's layout and its klayout-drc report loaded (needs the VNC/X11 desktop; usage: make load-drc-klayout [CELL=<cellname>])
	@if [ ! -f $(DRC_RPT_DIR)/$(CELL).klayout.drc/$(CELL).lyrdb ]; then \
		echo "ERROR: $(DRC_RPT_DIR)/$(CELL).klayout.drc/$(CELL).lyrdb not found. Run 'make klayout-drc CELL=$(CELL)' first."; \
		exit 1; \
	fi
	klayout -e $(LAY_DIR)/$(CELL).$(_GDS_EXT) -m $(DRC_RPT_DIR)/$(CELL).klayout.drc/$(CELL).lyrdb
.PHONY: load-drc-klayout

load-drc-magic: ## Open the Magic GUI with CELL's layout loaded and DRC already run, violations highlighted (needs the VNC/X11 desktop; usage: make load-drc-magic [CELL=<cellname>])
	mkdir -p $(DRC_RPT_DIR)
	printf '%s\n' \
		'gds read $(LAY_DIR)/$(CELL).$(_GDS_EXT)' \
		'load $(CELL)' \
		'select top cell' \
		'drc check' > $(DRC_RPT_DIR)/load_drc_$(CELL).tcl
	magic -rcfile $(PDK_ROOT)/$(PDK)/libs.tech/magic/$(PDK).magicrc $(DRC_RPT_DIR)/load_drc_$(CELL).tcl
.PHONY: load-drc-magic
# ================================================================================================


# LVS Targets
klayout-lvs-netlist: ## Export CDL schematic netlist from Xschem for KLayout LVS (usage: make klayout-lvs-netlist [CELL=<cellname>] [EV_PRECISION=<digits>])
	mkdir -p $(NET_SCH_DIR)
	xschem -s -r -x -q --rcfile $(XSCHEM_SCH_DIR)/xschemrc --command ' \
		set spiceprefix 1; \
		set lvs_netlist 1; \
		set top_is_subckt 1; \
		set lvs_ignore 1; \
		set ev_precision $(EV_PRECISION); \
		set netlist_dir $(NET_SCH_DIR); \
		xschem set netlist_name [file tail [file rootname [xschem get current_name]]]_klayout.cdl; \
		xschem netlist \
	' $(XSCHEM_SCH_DIR)/$(CELL).sch
.PHONY: klayout-lvs-netlist

klayout-lvs: ## Run KLayout LVS of the CELL cell (usage: make klayout-lvs [CELL=<cellname>])
	$(MAKE) klayout-lvs-netlist CELL=$(CELL)
	mkdir -p $(LVS_RPT_DIR)
	mkdir -p $(NET_LAY_DIR)
	sak-lvs.sh -d -k -w $(LVS_RPT_DIR) -s $(NET_SCH_DIR)/$(CELL)_klayout.cdl -l $(LAY_DIR)/$(CELL).$(_GDS_EXT) -c $(CELL)
	mv $(LVS_RPT_DIR)/$(CELL).klayout.lvs/$(CELL)_extracted.cir $(NET_LAY_DIR)/$(CELL)_klayout.cir
.PHONY: klayout-lvs

magic-lvs-netlist: ## Export SPICE schematic netlist from Xschem for Magic + Netgen LVS (usage: make magic-lvs-netlist [CELL=<cellname>] [EV_PRECISION=<digits>])
	mkdir -p $(NET_SCH_DIR)
	xschem -s -r -x -q --rcfile $(XSCHEM_SCH_DIR)/xschemrc --command ' \
		set spiceprefix 1; \
		set lvs_netlist 0; \
		set top_is_subckt 1; \
		set lvs_ignore 1; \
		set ev_precision $(EV_PRECISION); \
		set netlist_dir $(NET_SCH_DIR); \
		xschem set netlist_name [file tail [file rootname [xschem get current_name]]]_magic.spice; \
		xschem netlist \
	' $(XSCHEM_SCH_DIR)/$(CELL).sch
.PHONY: magic-lvs-netlist

magic-lvs: ## Run Magic + Netgen LVS of the CELL cell (usage: make magic-lvs [CELL=<cellname>])
	mkdir -p $(LVS_RPT_DIR)
	mkdir -p $(NET_LAY_DIR)
	$(MAKE) magic-lvs-netlist CELL=$(CELL)
	sak-lvs.sh -d -w $(LVS_RPT_DIR) -s $(NET_SCH_DIR)/$(CELL)_magic.spice -l $(LAY_DIR)/$(CELL).$(_GDS_EXT) -c $(CELL)
	mv $(LVS_RPT_DIR)/$(CELL).magic.lvs/$(CELL).ext.spc $(NET_LAY_DIR)/$(CELL)_magic.ext.spc
.PHONY: magic-lvs

# Mixed-Signal LVS Target
# magic-lvs always flattens the whole layout before extraction (sak-lvs.sh, to dodge a netgen
# nested-same-name-device bug), which destroys any digital macro's cell boundary - there is
# nothing left to compare it against afterward. This target extracts hierarchically instead (no
# flatten), so the layout netlist keeps each digital macro's real gate-level content. On the
# schematic side, a hardened macro's symbol is type=primitive (Xschem writes no .subckt body for
# it at all), so splice_digital_macro_netlist.py substitutes the real gate-level netlist the
# macro's own build already produced (netlist/spice/<macro>.spice) for every macro whose .sym
# carries sim_pinname= (the mark of such a macro, e.g. counter_top) - giving netgen real content
# on both sides instead of an empty/undefined black box. An empty black box's pins are otherwise
# indistinguishable to netgen's automorphism resolver (e.g. two power rails with identical
# fan-out become ambiguous), which real content resolves the same way it already resolves a
# plain analog macro like the inverter: by flattening the one mismatched subcell and matching it
# transistor-for-transistor.
magic-lvs-mixed: ## Run Magic + Netgen LVS of the CELL cell, splicing in real netlists for digital macros (usage: make magic-lvs-mixed [CELL=<cellname>])
	mkdir -p $(LVS_RPT_DIR)
	mkdir -p $(NET_LAY_DIR)
	$(MAKE) magic-lvs-netlist CELL=$(CELL)
	rm -rf $(LVS_RPT_DIR)/$(CELL).magic.lvs
	mkdir -p $(LVS_RPT_DIR)/$(CELL).magic.lvs
	printf '%s\n' \
		'crashbackups stop' \
		'drc off' \
		'gds read $(LAY_DIR)/$(CELL).$(_GDS_EXT)' \
		'load $(CELL)' \
		'select top cell' \
		'extract path $(LVS_RPT_DIR)/$(CELL).magic.lvs' \
		'extract no capacitance' \
		'extract no coupling' \
		'extract no resistance' \
		'extract no length' \
		'extract all' \
		'ext2spice lvs' \
		'ext2spice -p $(LVS_RPT_DIR)/$(CELL).magic.lvs -o $(NET_LAY_DIR)/$(CELL)_magic.ext.spc' \
		'quit -noprompt' | \
		magic -dnull -noconsole \
		-rcfile $(PDK_ROOT)/$(PDK)/libs.tech/magic/$(PDK).magicrc
	python3 $(SCRIPTS_DIR)/reorder_top_pins.py $(NET_LAY_DIR)/$(CELL)_magic.ext.spc $(NET_SCH_DIR)/$(CELL)_magic.spice $(CELL)
	python3 $(SCRIPTS_DIR)/splice_digital_macro_netlist.py $(NET_SCH_DIR)/$(CELL)_magic.spice --root .
	netgen -batch lvs \
		"$(NET_LAY_DIR)/$(CELL)_magic.ext.spc $(CELL)" \
		"$(NET_SCH_DIR)/$(CELL)_magic.spice $(CELL)" \
		$(PDK_ROOT)/$(PDK)/libs.tech/netgen/$(PDK)_setup.tcl \
		$(LVS_RPT_DIR)/$(CELL).magic.lvs/$(CELL).lvs.out
	@grep -qi "Circuits match uniquely" $(LVS_RPT_DIR)/$(CELL).magic.lvs/$(CELL).lvs.out && \
		echo "[INFO] Magic+Netgen mixed-signal LVS is OK, schematic/netlist and layout match!" || \
		{ echo "[ERROR] Magic+Netgen mixed-signal LVS errors found! Please check $(LVS_RPT_DIR)/$(CELL).magic.lvs/$(CELL).lvs.out"; exit 1; }
.PHONY: magic-lvs-mixed
# ================================================================================================


# PEX Targets
symbol-pex: ## Build the Xschem PEX symbol <CELL>_pex.sym from <CELL>.sym (usage: make symbol-pex [CELL=<cellname>])
	@if [ ! -f $(XSCHEM_SCH_DIR)/$(CELL).sym ]; then \
		echo "No symbol $(XSCHEM_SCH_DIR)/$(CELL).sym found, skipping PEX symbol generation."; \
	else \
		sed 's/type=subcircuit/type=primitive/' $(XSCHEM_SCH_DIR)/$(CELL).sym > $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym; \
		if ! grep -q 'type=primitive' $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym; then \
			rm -f $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym; \
			echo "ERROR: $(XSCHEM_SCH_DIR)/$(CELL).sym declares neither type=subcircuit nor type=primitive!"; \
			exit 1; \
		fi; \
		echo "Wrote $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym (copy of $(CELL).sym with type=primitive)."; \
	fi
.PHONY: symbol-pex

klayout-pex: ## Run Parasitic Extraction with KPEX of the CELL cell (usage: make klayout-pex [CELL=<cellname>] [EXT_MODE=<1|2|3>])
	mkdir -p $(NET_PEX_DIR)
	$(MAKE) symbol-pex CELL=$(CELL)
	PDK_UNDERSCORED=$$(echo $$PDK | sed -e 's/-/_/g'); \
	case $(EXT_MODE) in \
		1) echo "WARNING: KPEX does not support C-decoupled (C) mode yet, using C-coupled (CC) mode instead."; KPEX_MODE=CC ;; \
		2) KPEX_MODE=CC ;; \
		3) KPEX_MODE=RC ;; \
		*) echo "Invalid EXT_MODE: $(EXT_MODE). Use 1, 2, or 3."; exit 1;; \
	esac; \
	kpex \
	--pdk $$PDK_UNDERSCORED \
	--cell $(CELL) \
	--schematic $(XSCHEM_SCH_DIR)/$(CELL).sch \
	--gds $(LAY_DIR)/$(CELL).$(_GDS_EXT) \
	--magic \
	--magic_mode $$KPEX_MODE \
	--out_dir $(NET_PEX_DIR) \
	--out_spice $(NET_PEX_DIR)/$(CELL)_klayout_pex_$(EXT_MODE).spice
#	--2.5D
#	--mode $$KPEX_MODE
	sed -i 's/$(CELL)/$(CELL)_pex/g' $(NET_PEX_DIR)/$(CELL)_klayout_pex_$(EXT_MODE).spice
	rm -rf $(NET_PEX_DIR)/$(CELL)__$(CELL)
	rm -f $(CELL).nodes $(CELL).sim
	@if [ -f $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym ]; then \
		echo "Reordering pins in $(CELL)_klayout_pex_$(EXT_MODE).spice to match $(CELL)_pex.sym..."; \
		sak-pin-reorder.py $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym $(NET_PEX_DIR)/$(CELL)_klayout_pex_$(EXT_MODE).spice --format spice; \
	else \
		echo "No symbol $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym found, skipping pin reorder."; \
	fi
	python3 $(SCRIPTS_DIR)/check_pex_ports.py $(NET_PEX_DIR)/$(CELL)_klayout_pex_$(EXT_MODE).spice
.PHONY: klayout-pex

magic-pex: ## Run Parasitic Extraction with Magic of the CELL cell (usage: make magic-pex [CELL=<cellname>] [EXT_MODE=<1|2|3>] [THRESHOLD=<mOhm>] [MINRES=<mOhm>] [MINDELAY=<ps>])
	mkdir -p $(NET_PEX_DIR)
	$(MAKE) symbol-pex CELL=$(CELL)
	sak-pex.sh -d -m $(EXT_MODE) -n $(CELL)_pex -t $(THRESHOLD) -r $(MINRES) -y $(MINDELAY) -w $(NET_PEX_DIR) $(LAY_DIR)/$(CELL).$(_GDS_EXT)
	mv $(NET_PEX_DIR)/$(CELL).pex.spice $(NET_PEX_DIR)/$(CELL)_magic_pex_$(EXT_MODE).spice
	rm -f $(NET_PEX_DIR)/pex_$(CELL).tcl
	@if [ -f $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym ]; then \
		echo "Reordering pins in $(CELL)_magic_pex_$(EXT_MODE).spice to match $(CELL)_pex.sym..."; \
		sak-pin-reorder.py $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym $(NET_PEX_DIR)/$(CELL)_magic_pex_$(EXT_MODE).spice --format spice; \
	else \
		echo "No symbol $(XSCHEM_SCH_DIR)/$(CELL)_pex.sym found, skipping pin reorder."; \
	fi
	python3 $(SCRIPTS_DIR)/check_pex_ports.py $(NET_PEX_DIR)/$(CELL)_magic_pex_$(EXT_MODE).spice
.PHONY: magic-pex
# ================================================================================================


# Verify Targets
klayout-verify: ## Verify CELL cell with KLayout (usage: make klayout-verify [CELL=<cellname>] [SKIP_KLAYOUT_LVS=<0|1>])
	$(MAKE) klayout-drc CELL=$(CELL)
	@if [ "$(SKIP_KLAYOUT_LVS)" = "1" ]; then \
		echo "Skipping klayout-lvs for $(CELL) (SKIP_KLAYOUT_LVS=1)"; \
	else \
		$(MAKE) klayout-lvs CELL=$(CELL); \
	fi
#	$(MAKE) klayout-pex CELL=$(CELL)
.PHONY: klayout-verify

klayout-verify-all: ## Verify the top-level cell with KLayout (DRC, LVS)
	$(MAKE) klayout-verify CELL=$(TOP)
.PHONY: klayout-verify-all

magic-verify: ## Verify CELL cell with Magic (usage: make magic-verify [CELL=<cellname>] [MIXED_LVS=<0|1>])
	$(MAKE) magic-drc CELL=$(CELL)
	@if [ "$(MIXED_LVS)" = "1" ]; then \
		$(MAKE) magic-lvs-mixed CELL=$(CELL); \
	else \
		$(MAKE) magic-lvs CELL=$(CELL); \
	fi
	$(MAKE) magic-pex CELL=$(CELL)
.PHONY: magic-verify

magic-verify-all: ## Verify the top-level cell with Magic (DRC, LVS, PEX)
	$(MAKE) magic-verify CELL=$(TOP)
.PHONY: magic-verify-all
# ================================================================================================


# Verify, Build and Simulate All Target
all: ## Verify, build and simulate the macros and the TOP cell
	$(MAKE) build-macros
	$(MAKE) klayout-verify-all
	$(MAKE) magic-verify-all
	$(MAKE) build-top
	$(MAKE) sim-all
.PHONY: all
# ================================================================================================


# Clean Targets
clean: ## Delete all generated files and folders of the TOP cell (final, netlists, render, DRC/LVS reports, simulation outputs)
	rm -rf $(GDS_DIR) $(LEF_DIR) $(LIB_DIR) $(VH_DIR)
	rm -rf $(NET_SCH_DIR) $(NET_LAY_DIR) $(NET_PEX_DIR)
	rm -rf $(RENDER_IMG_DIR)
	rm -rf $(DRC_RPT_DIR) $(LVS_RPT_DIR)
	rm -rf $(XSCHEM_SCH_DIR)/simulations $(XSCHEM_TB_DIR)/simulations
	rm -rf $(SIM_PLOT_DIR)/data $(SIM_PLOT_DIR)/figures $(SIM_PLOT_DIR)/__pycache__
	rm -rf $(SCRIPTS_DIR)/__pycache__
.PHONY: clean

clean-counter: ## Delete all generated files and folders of the counter macro
	@$(MAKE) -C $(MACROS_DIR)/counter clean
.PHONY: clean-counter

clean-inverter: ## Delete all generated files and folders of the inverter macro
	@$(MAKE) -C $(MACROS_DIR)/inverter clean
.PHONY: clean-inverter

clean-macros: ## Delete all generated files and folders of all macros (counter and inverter)
	$(MAKE) clean-counter
	$(MAKE) clean-inverter
#	ToDo: further macros
.PHONY: clean-macros

clean-all: ## Delete all generated files and folders of the macros and the TOP cell
	$(MAKE) clean-macros
	$(MAKE) clean
.PHONY: clean-all
# ================================================================================================
